# ==========================================
# CYVEXA Django Environment Configuration
# ==========================================

# Security
SECRET_KEY=your-super-secret-random-key-here-minimum-50-characters
DEBUG=False

# Domains and Hosts (comma-separated, without scheme)
ALLOWED_HOSTS=.vercel.app,cyvexa.com,www.cyvexa.com,localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated, with scheme)
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://cyvexa.com,https://www.cyvexa.com

# Production Database (PostgreSQL URL e.g. Neon, Supabase, Railway, Vercel Postgres, AWS RDS)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Optional Security Overrides (Vercel edge handles HTTPS by default)
SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000
